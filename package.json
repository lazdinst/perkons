{
  "name": "perkons",
  "productName": "Pērkons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Windows soundboard with optional microphone mixing.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "npm run build && node scripts/smoke.mjs",
    "dist": "npm run build && electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "lv.perkons.soundboard",
    "productName": "Pērkons",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Perkons-${version}-portable.exe"
    }
  }
}
